{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zq-cfgit-apps",
  "main": "src/apps-gateway.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
    "database_name": "zq-cfgit",
    "database_id": "a0bcc81a-0b08-40e6-af34-6865eb14d42d",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "zq-cfgit-objects",
    },
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
}
