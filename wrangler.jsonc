{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zq-cfgit",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
    "database_name": "zq-cfgit",
    "database_id": "a0bcc81a-0b08-40e6-af34-6865eb14d42d",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "zq-cfgit-objects",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPOSITORIES",
        "class_name": "Repository",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Repository"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
}
