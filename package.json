{
  "name": "zq-cfgit",
  "version": "1.0.0",
  "private": true,
  "description": "Git hosting on Cloudflare Workers, R2 and Durable Objects",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.local.jsonc",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "source": "node scripts/source.mjs",
    "predeploy": "npm run source",
    "prebuild": "npm run source",
    "format": "prettier --write src public scripts *.md *.json *.jsonc"
  },
  "dependencies": {
    "diff": "9.0.0",
    "dompurify": "3.4.15",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.7",
    "markdown-it": "^15.0.1",
    "pako": "2.2.0",
    "re2js": "2.8.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.0",
    "@types/pako": "^2.0.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.1"
  }
}
