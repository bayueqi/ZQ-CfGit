{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zq-cfgit-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "subrequests": 250000 },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "BOOTSTRAP_SECRET": "local-development-only-change-me",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zq-cfgit-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "zq-cfgit-local",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPOSITORIES",
        "class_name": "Repository",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Repository"],
    },
  ],
  "dev": {
    "port": 8787,
    "ip": "127.0.0.1",
  },
}
